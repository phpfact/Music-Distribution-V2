# Environment template. Contains placeholders only; never put real secrets here.
#
#   make init      creates .env from this file and replaces every "change-me..."
#                  value with a random secret
#
# .env is git-ignored and is never copied into a Docker image.
# None of these values may be given a NEXT_PUBLIC_ prefix: that would ship them
# to the browser.
#
# IMPORTANT: the PostgreSQL and pgAdmin credentials are applied only when their
# data volume is first created. Editing them here later does NOT change an
# existing database or login (see README, "Credentials").

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=music_distribution
POSTGRES_USER=music_distribution
# Secret. Development: generated by `make init`. Production: set your own (16+ chars).
POSTGRES_PASSWORD=change-me-postgres-password
# Maximum connections each application instance holds to the control-plane database.
POSTGRES_POOL_MAX=10
# Tenant databases: connections per tenant, and how many tenants' clients an
# instance keeps open before closing the least recently used one.
POSTGRES_TENANT_POOL_MAX=3
POSTGRES_TENANT_CLIENTS_MAX=50

# --- Redis -------------------------------------------------------------------
# Secret. Applied on every start, so changing it takes effect on restart.
REDIS_PASSWORD=change-me-redis-password
# Memory cap and what happens when it is reached (see docker/redis/redis.conf).
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction

# --- Tenants -----------------------------------------------------------------
# Secret. Encrypts the tenant database passwords stored in the control plane
# (AES-256-GCM, key derived from this value). Generated by `make init`.
# Production: set your own (16+ chars) and BACK IT UP with the database
# backups. If it is lost or changed, every stored tenant database password
# becomes unrecoverable and those tenants cannot be reached until their
# passwords are reset.
TENANT_SECRETS_KEY=change-me-tenant-secrets-key
# Tenants get the subdomain <label>.<PLATFORM_BASE_DOMAIN>. Lower-case host
# name, no scheme or port. Default "localhost": *.localhost resolves to this
# machine in browsers, so development needs no DNS. Production: your domain,
# with a wildcard DNS record *.<domain> pointing to the application.
PLATFORM_BASE_DOMAIN=localhost
# Uploaded files (e.g. tenant profile images) are stored under /app/storage in
# the containers: the project folder's storage/ in development (git-ignored),
# the app_storage volume in production. Back it up with the database.

# --- pgAdmin (initial login) -------------------------------------------------
# Must be a real-looking address; reserved domains such as .local are rejected.
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Secret.
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# --- Platform owner (initial account) ----------------------------------------
# Used only by `make db-seed` (production: `make prod-seed`), which creates the
# first platform owner account when none exists. Compose passes them to that
# command only, not to the application container.
# Changing them later does NOT change an existing account. To change the
# password, set the new one here and run `make db-rotate-owner-password`.
# Both lines may be removed from the env file once the account exists.
PLATFORM_OWNER_INITIAL_USERNAME=owner
# Secret, 12 to 256 characters. Generated by `make init`; you sign in with it.
PLATFORM_OWNER_INITIAL_PASSWORD=change-me-platform-owner-password

# --- Host ports --------------------------------------------------------------
# Address the application port is published on. 127.0.0.1 = this machine only.
# In production keep 127.0.0.1 and put an HTTPS reverse proxy in front.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# The two GUIs are always published on 127.0.0.1 only.
PGADMIN_PORT=5050
REDISINSIGHT_PORT=5540
# Development only (production does not publish these). Always 127.0.0.1.
# Deliberately not 5432/6379, which a natively installed PostgreSQL or Redis
# usually holds. Inside Docker the services still use their standard ports.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Development only ---------------------------------------------------------
# Hot reload uses Turbopack with native file events by default. Only if edits
# are not picked up (e.g. project on a Windows drive under WSL 2), switch the
# dev server to webpack with file polling by uncommenting BOTH lines:
# NEXT_DEV_BUNDLER=webpack
# WATCHPACK_POLLING=true

# --- Production only (optional overrides) ------------------------------------
# The production image name and tag are Makefile variables, not env-file
# settings: make prod-up APP_IMAGE=<name> APP_TAG=<tag>
# APP_CPU_LIMIT=1.0
# APP_MEMORY_LIMIT=512m
# POSTGRES_CPU_LIMIT=1.0
# POSTGRES_MEMORY_LIMIT=1g
# REDIS_CPU_LIMIT=0.5
# REDIS_MEMORY_LIMIT=512m
