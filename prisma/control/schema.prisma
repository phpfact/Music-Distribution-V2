// Control-plane database: platform-wide tenant metadata and platform owners.
//
// One database for the whole platform (POSTGRES_DB). It records which tenants
// exist and where their data lives, and who may sign in as a platform owner.
// Tenant business records (users, customers, releases) never belong here; they
// live in each tenant's own database, whose schema is
// prisma/tenant/schema.prisma.
//
// The connection is configured in prisma/control.config.ts, not in this file.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma/control"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  pending
  provisioning
  active
  failed
  suspended
  deprovisioning

  @@map("tenant_status")
}

/// State of a tenant database's schema relative to prisma/tenant/migrations.
enum TenantSchemaStatus {
  pending
  current
  failed

  @@map("tenant_schema_status")
}

enum TenantDomainType {
  subdomain
  custom

  @@map("tenant_domain_type")
}

/// `active` once the DNS check has passed. A pending custom domain never
/// blocks the tenant: its SaaS subdomain keeps working.
enum TenantDomainStatus {
  pending
  active
  failed

  @@map("tenant_domain_status")
}

/// `provisioned`: the platform created the tenant's database and login.
/// `existing`: the owner attached a database that already existed.
enum TenantDatabaseMode {
  provisioned
  existing

  @@map("tenant_database_mode")
}

enum ProvisioningRunStatus {
  running
  succeeded
  failed

  @@map("provisioning_run_status")
}

enum ProvisioningStep {
  create_database
  create_database_user
  grant_privileges
  apply_migrations
  create_initial_admin
  register_domain
  verify
  /// Existing-database mode only, instead of create_database_user and create_database.
  check_database

  @@map("provisioning_step")
}

enum AuditActorType {
  system
  super_admin
  tenant_user
  /// A customer user (or sub-customer user) of a tenant portal.
  customer_user

  @@map("audit_actor_type")
}

enum PlatformOwnerStatus {
  active
  disabled

  @@map("platform_owner_status")
}

model Plan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  /// The plan given to newly registered tenants.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  name            String       @db.VarChar(200)
  /// Lower-case DNS label (checked in the database, see the init migration).
  slug            String       @unique @db.VarChar(63)
  status          TenantStatus @default(pending)
  /// Why the tenant is in this status. Safe to display; detail goes to the logs.
  statusReason    String?      @map("status_reason") @db.VarChar(500)
  /// The tenant admin's e-mail. Lower-case (checked in the database).
  contactEmail    String       @unique @map("contact_email") @db.VarChar(320)
  /// The tenant admin's login name, in the same format as platform owner user
  /// names (checked in the database).
  adminUsername   String       @unique @map("admin_username") @db.VarChar(64)
  /// Digits with an optional leading "+" (checked in the database).
  phone           String?      @db.VarChar(16)
  /// Storage key of the profile image (see src/lib/storage). Never a URL.
  profileImageKey String?      @map("profile_image_key") @db.VarChar(255)

  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  databaseMode      TenantDatabaseMode @default(provisioned) @map("database_mode")
  // Allocated during provisioning, so empty until then.
  databaseName      String?            @unique @map("database_name") @db.VarChar(63)
  databaseUser      String?            @unique @map("database_user") @db.VarChar(63)
  /// Port of the PostgreSQL server at POSTGRES_HOST that holds the database
  /// (1-65535, checked in the database).
  databasePort      Int?               @map("database_port")
  /// The id of the credential's row in `secrets`. Never the secret itself.
  databaseSecretRef String?            @map("database_secret_ref") @db.VarChar(255)

  /// Argon2id hash (PHC format) of the tenant admin's password, kept only until
  /// provisioning has written it into the tenant database; NULL afterwards.
  pendingAdminPasswordHash String? @map("pending_admin_password_hash") @db.VarChar(255)

  schemaStatus     TenantSchemaStatus @default(pending) @map("schema_status")
  /// Name of the newest tenant migration applied to this tenant's database.
  schemaVersion    String?            @map("schema_version") @db.VarChar(255)
  schemaMigratedAt DateTime?          @map("schema_migrated_at") @db.Timestamptz(3)

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains           TenantDomain[]
  provisioningRuns  TenantProvisioningRun[]
  provisioningSteps TenantProvisioningStep[]
  moduleSettings    TenantModuleSetting[]

  @@index([status])
  @@index([planId])
  @@map("tenants")
}

model TenantDomain {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type              TenantDomainType   @default(subdomain)
  /// Lower-case (checked in the database). For `subdomain` the label under the
  /// SaaS base domain ("acme"); for `custom` the full host name.
  hostname          String             @db.VarChar(253)
  status            TenantDomainStatus @default(pending)
  /// Expected in the custom domain's DNS TXT record. Empty for subdomains.
  verificationToken String?            @map("verification_token") @db.VarChar(64)
  verifiedAt        DateTime?          @map("verified_at") @db.Timestamptz(3)
  lastCheckedAt     DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  /// Why the last DNS check failed. Safe to display.
  lastCheckError    String?            @map("last_check_error") @db.VarChar(300)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  // A tenant has one subdomain row and at most one custom row: partial unique
  // indexes in the tenant_management migration.
  @@unique([type, hostname])
  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantProvisioningRun {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// 1 for the first run, incremented on every retry.
  attempt      Int
  status       ProvisioningRunStatus @default(running)
  /// The step in progress, or the step that failed.
  step         ProvisioningStep?
  errorCode    String?               @map("error_code") @db.VarChar(100)
  /// Safe to display. Never a password, connection string or other secret.
  errorMessage String?               @map("error_message") @db.VarChar(500)
  startedAt    DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?             @map("finished_at") @db.Timestamptz(3)

  completedSteps TenantProvisioningStep[]

  @@unique([tenantId, attempt])
  @@map("tenant_provisioning_runs")
}

/// A provisioning step that has succeeded for a tenant. A retry skips these.
model TenantProvisioningStep {
  tenantId    String                @map("tenant_id") @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  step        ProvisioningStep
  completedAt DateTime              @default(now()) @map("completed_at") @db.Timestamptz(3)
  /// The run in which the step succeeded.
  runId       String                @map("run_id") @db.Uuid
  run         TenantProvisioningRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([tenantId, step])
  @@index([runId])
  @@map("tenant_provisioning_steps")
}

/// A secret encrypted with AES-256-GCM under a key derived from
/// TENANT_SECRETS_KEY (see src/lib/secrets). The id and purpose are bound to the
/// ciphertext as additional authenticated data, so a row cannot be moved or
/// reused for another purpose. The plaintext is never stored.
model Secret {
  /// Generated by the application before encrypting: it is part of the AAD.
  id         String   @id @db.Uuid
  /// What the secret is for, e.g. "tenant_database_password".
  purpose    String   @db.VarChar(50)
  /// Which key derivation encrypted it, so the key can be rotated later.
  keyVersion Int      @map("key_version") @db.SmallInt
  nonce      Bytes
  ciphertext Bytes
  authTag    Bytes    @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("secrets")
}

/// Append-only: a trigger refuses UPDATE, DELETE and TRUNCATE (rbac migration).
model AuditEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.VarChar(100)
  /// Deliberately not a foreign key: audit rows must outlive the tenant record.
  tenantId   String?        @map("tenant_id") @db.Uuid
  /// What happened, e.g. "tenant.suspended".
  action     String         @db.VarChar(100)
  targetType String?        @map("target_type") @db.VarChar(100)
  targetId   String?        @map("target_id") @db.VarChar(100)
  /// Never credentials, tokens or private media URLs.
  metadata   Json?
  ipAddress  String?        @map("ip_address") @db.Inet

  @@index([tenantId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

/// Themes supported by the Platform Panel.
enum AppearanceTheme {
  light
  dark
  system

  @@map("appearance_theme")
}

/// Brand accents. `neutral` (shadcn's black-and-white look) is the application
/// default; the colours are selectable in Appearance settings.
enum AppearanceAccent {
  neutral
  emerald
  indigo
  violet
  blue
  rose
  amber

  @@map("appearance_accent")
}

/// Responsive caps for the available Platform Panel content area.
enum AppearanceWidth {
  default
  full
  focused

  @@map("appearance_width")
}

model PlatformOwner {
  id           String              @id @default(uuid(7)) @db.Uuid
  /// Lower-case (checked in the database).
  username     String              @unique @db.VarChar(64)
  /// Argon2id hash in PHC format. Never the password itself.
  passwordHash String              @map("password_hash") @db.VarChar(255)
  status       PlatformOwnerStatus @default(active)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Display name of a Sub-Platform Owner (optional for existing accounts).
  fullName    String?        @map("full_name") @db.VarChar(200)
  /// The seeded/oldest Platform Owner: always Master Platform, never suspended
  /// or reassigned through RBAC paths. At most one (partial unique index in the
  /// rbac migration).
  isPrimary   Boolean        @default(false) @map("is_primary")
  /// Exactly one role (.vibe/memory/role-privilege-management.md). A role in
  /// use cannot be deleted (RESTRICT).
  roleId      String         @map("role_id") @db.Uuid
  role        PlatformRole   @relation("PlatformOwnerRole", fields: [roleId], references: [id], onDelete: Restrict)
  /// The owner who created this account; empty for the seeded owner.
  createdById String?        @map("created_by_id") @db.Uuid
  createdBy   PlatformOwner? @relation("PlatformOwnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sessions           PlatformOwnerSession[]
  personalAppearance PlatformOwnerAppearance?
  createdOwners      PlatformOwner[]          @relation("PlatformOwnerCreatedBy")
  createdRoles       PlatformRole[]           @relation("PlatformRoleCreatedBy")
  platformModules    PlatformModuleSetting[]
  tenantModules      TenantModuleSetting[]

  @@index([roleId])
  @@map("platform_owners")
}

model PlatformOwnerSession {
  id         String        @id @default(uuid(7)) @db.Uuid
  ownerId    String        @map("owner_id") @db.Uuid
  owner      PlatformOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the session token. The token itself is only ever in the
  /// owner's cookie.
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@index([expiresAt])
  @@map("platform_owner_sessions")
}

/// One personal override per authenticated platform owner. Deleting this row
/// resets only that owner to the global appearance (or application default).
model PlatformOwnerAppearance {
  ownerId   String           @id @map("owner_id") @db.Uuid
  owner     PlatformOwner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  theme     AppearanceTheme
  accent    AppearanceAccent
  /// Default preserves the existing content cap on all persisted appearances.
  width     AppearanceWidth  @default(default)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_owner_appearances")
}

/// Exactly one platform default, enforced by a database CHECK on id.
/// Global apply also updates only the initiating owner's existing override.
/// Global reset leaves every personal override unchanged.
model PlatformAppearance {
  id        String           @id @default("platform") @db.VarChar(32)
  theme     AppearanceTheme
  accent    AppearanceAccent
  /// Default preserves the existing content cap on all persisted appearances.
  width     AppearanceWidth  @default(default)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_appearance")
}

// ---------------------------------------------------------------------------
// Role and privilege management (.vibe/memory/role-privilege-management.md)

/// Custom roles can be disabled; the master role is always active (CHECK).
enum RoleStatus {
  active
  disabled

  @@map("role_status")
}

/// Mirror of the platform domain of src/lib/authz/catalog.ts, written by
/// migrations only. Keys are stable; labels are display text.
model PlatformPermission {
  /// `<module>.<action>`, always `platform.` (CHECK).
  key         String   @id @db.VarChar(100)
  moduleKey   String   @map("module_key") @db.VarChar(100)
  action      String   @db.VarChar(50)
  label       String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles PlatformRolePermission[]

  @@index([moduleKey])
  @@map("platform_permissions")
}

/// A platform role. The master role is recognised by `systemKey` only and
/// grants every platform privilege; a custom role grants its stored privileges.
model PlatformRole {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively (index on lower(name) in the rbac migration).
  name        String         @db.VarChar(100)
  description String?        @db.VarChar(500)
  status      RoleStatus     @default(active)
  /// 'master_platform' for the master role, empty for custom roles (CHECK).
  systemKey   String?        @unique @map("system_key") @db.VarChar(50)
  createdById String?        @map("created_by_id") @db.Uuid
  createdBy   PlatformOwner? @relation("PlatformRoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions PlatformRolePermission[]
  owners      PlatformOwner[]          @relation("PlatformOwnerRole")

  @@map("platform_roles")
}

/// A privilege stored on a custom platform role.
model PlatformRolePermission {
  roleId        String             @map("role_id") @db.Uuid
  role          PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String             @map("permission_key") @db.VarChar(100)
  permission    PlatformPermission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("platform_role_permissions")
}

/// Platform-wide switch of a platform module. An absent row means enabled;
/// rows of core modules are ignored by the resolver.
model PlatformModuleSetting {
  /// A platform module key (CHECK: starts with "platform.").
  moduleKey   String         @id @map("module_key") @db.VarChar(100)
  enabled     Boolean
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?        @map("updated_by_id") @db.Uuid
  updatedBy   PlatformOwner? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_module_settings")
}

/// Per-tenant switch of a tenant or customer panel module, set by the Platform
/// Owner. An absent row means enabled; rows of core modules are ignored.
model TenantModuleSetting {
  tenantId    String         @map("tenant_id") @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// A tenant or customer module key (CHECK).
  moduleKey   String         @map("module_key") @db.VarChar(100)
  enabled     Boolean
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?        @map("updated_by_id") @db.Uuid
  updatedBy   PlatformOwner? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([tenantId, moduleKey])
  @@map("tenant_module_settings")
}
