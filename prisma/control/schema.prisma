// Control-plane database: platform-wide tenant metadata and platform owners.
//
// One database for the whole platform (POSTGRES_DB). It records which tenants
// exist and where their data lives, and who may sign in as a platform owner.
// Tenant business records (users, customers, releases) never belong here; they
// live in each tenant's own database, whose schema is
// prisma/tenant/schema.prisma.
//
// The connection is configured in prisma/control.config.ts, not in this file.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma/control"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  pending
  provisioning
  active
  failed
  suspended
  deprovisioning

  @@map("tenant_status")
}

/// State of a tenant database's schema relative to prisma/tenant/migrations.
enum TenantSchemaStatus {
  pending
  current
  failed

  @@map("tenant_schema_status")
}

enum TenantDomainType {
  subdomain
  custom

  @@map("tenant_domain_type")
}

/// `active` once the DNS check has passed. A pending custom domain never
/// blocks the tenant: its SaaS subdomain keeps working.
enum TenantDomainStatus {
  pending
  active
  failed

  @@map("tenant_domain_status")
}

/// `provisioned`: the platform created the tenant's database and login.
/// `existing`: the owner attached a database that already existed.
enum TenantDatabaseMode {
  provisioned
  existing

  @@map("tenant_database_mode")
}

enum ProvisioningRunStatus {
  running
  succeeded
  failed

  @@map("provisioning_run_status")
}

enum ProvisioningStep {
  create_database
  create_database_user
  grant_privileges
  apply_migrations
  create_initial_admin
  register_domain
  verify
  /// Existing-database mode only, instead of create_database_user and create_database.
  check_database

  @@map("provisioning_step")
}

enum AuditActorType {
  system
  super_admin
  tenant_user

  @@map("audit_actor_type")
}

enum PlatformOwnerStatus {
  active
  disabled

  @@map("platform_owner_status")
}

model Plan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  /// The plan given to newly registered tenants.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  name            String       @db.VarChar(200)
  /// Lower-case DNS label (checked in the database, see the init migration).
  slug            String       @unique @db.VarChar(63)
  status          TenantStatus @default(pending)
  /// Why the tenant is in this status. Safe to display; detail goes to the logs.
  statusReason    String?      @map("status_reason") @db.VarChar(500)
  /// The tenant admin's e-mail. Lower-case (checked in the database).
  contactEmail    String       @unique @map("contact_email") @db.VarChar(320)
  /// The tenant admin's login name, in the same format as platform owner user
  /// names (checked in the database).
  adminUsername   String       @unique @map("admin_username") @db.VarChar(64)
  /// Digits with an optional leading "+" (checked in the database).
  phone           String?      @db.VarChar(16)
  /// Storage key of the profile image (see src/lib/storage). Never a URL.
  profileImageKey String?      @map("profile_image_key") @db.VarChar(255)

  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  databaseMode      TenantDatabaseMode @default(provisioned) @map("database_mode")
  // Allocated during provisioning, so empty until then.
  databaseName      String?            @unique @map("database_name") @db.VarChar(63)
  databaseUser      String?            @unique @map("database_user") @db.VarChar(63)
  /// Port of the PostgreSQL server at POSTGRES_HOST that holds the database
  /// (1-65535, checked in the database).
  databasePort      Int?               @map("database_port")
  /// The id of the credential's row in `secrets`. Never the secret itself.
  databaseSecretRef String?            @map("database_secret_ref") @db.VarChar(255)

  /// Argon2id hash (PHC format) of the tenant admin's password, kept only until
  /// provisioning has written it into the tenant database; NULL afterwards.
  pendingAdminPasswordHash String? @map("pending_admin_password_hash") @db.VarChar(255)

  schemaStatus     TenantSchemaStatus @default(pending) @map("schema_status")
  /// Name of the newest tenant migration applied to this tenant's database.
  schemaVersion    String?            @map("schema_version") @db.VarChar(255)
  schemaMigratedAt DateTime?          @map("schema_migrated_at") @db.Timestamptz(3)

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains           TenantDomain[]
  provisioningRuns  TenantProvisioningRun[]
  provisioningSteps TenantProvisioningStep[]

  @@index([status])
  @@index([planId])
  @@map("tenants")
}

model TenantDomain {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type              TenantDomainType   @default(subdomain)
  /// Lower-case (checked in the database). For `subdomain` the label under the
  /// SaaS base domain ("acme"); for `custom` the full host name.
  hostname          String             @db.VarChar(253)
  status            TenantDomainStatus @default(pending)
  /// Expected in the custom domain's DNS TXT record. Empty for subdomains.
  verificationToken String?            @map("verification_token") @db.VarChar(64)
  verifiedAt        DateTime?          @map("verified_at") @db.Timestamptz(3)
  lastCheckedAt     DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  /// Why the last DNS check failed. Safe to display.
  lastCheckError    String?            @map("last_check_error") @db.VarChar(300)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  // A tenant has one subdomain row and at most one custom row: partial unique
  // indexes in the tenant_management migration.
  @@unique([type, hostname])
  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantProvisioningRun {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// 1 for the first run, incremented on every retry.
  attempt      Int
  status       ProvisioningRunStatus @default(running)
  /// The step in progress, or the step that failed.
  step         ProvisioningStep?
  errorCode    String?               @map("error_code") @db.VarChar(100)
  /// Safe to display. Never a password, connection string or other secret.
  errorMessage String?               @map("error_message") @db.VarChar(500)
  startedAt    DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?             @map("finished_at") @db.Timestamptz(3)

  completedSteps TenantProvisioningStep[]

  @@unique([tenantId, attempt])
  @@map("tenant_provisioning_runs")
}

/// A provisioning step that has succeeded for a tenant. A retry skips these.
model TenantProvisioningStep {
  tenantId    String                @map("tenant_id") @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  step        ProvisioningStep
  completedAt DateTime              @default(now()) @map("completed_at") @db.Timestamptz(3)
  /// The run in which the step succeeded.
  runId       String                @map("run_id") @db.Uuid
  run         TenantProvisioningRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([tenantId, step])
  @@index([runId])
  @@map("tenant_provisioning_steps")
}

/// A secret encrypted with AES-256-GCM under a key derived from
/// TENANT_SECRETS_KEY (see src/lib/secrets). The id and purpose are bound to the
/// ciphertext as additional authenticated data, so a row cannot be moved or
/// reused for another purpose. The plaintext is never stored.
model Secret {
  /// Generated by the application before encrypting: it is part of the AAD.
  id         String   @id @db.Uuid
  /// What the secret is for, e.g. "tenant_database_password".
  purpose    String   @db.VarChar(50)
  /// Which key derivation encrypted it, so the key can be rotated later.
  keyVersion Int      @map("key_version") @db.SmallInt
  nonce      Bytes
  ciphertext Bytes
  authTag    Bytes    @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("secrets")
}

model AuditEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.VarChar(100)
  /// Deliberately not a foreign key: audit rows must outlive the tenant record.
  tenantId   String?        @map("tenant_id") @db.Uuid
  /// What happened, e.g. "tenant.suspended".
  action     String         @db.VarChar(100)
  targetType String?        @map("target_type") @db.VarChar(100)
  targetId   String?        @map("target_id") @db.VarChar(100)
  /// Never credentials, tokens or private media URLs.
  metadata   Json?
  ipAddress  String?        @map("ip_address") @db.Inet

  @@index([tenantId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

model PlatformOwner {
  id           String              @id @default(uuid(7)) @db.Uuid
  /// Lower-case (checked in the database).
  username     String              @unique @db.VarChar(64)
  /// Argon2id hash in PHC format. Never the password itself.
  passwordHash String              @map("password_hash") @db.VarChar(255)
  status       PlatformOwnerStatus @default(active)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions PlatformOwnerSession[]

  @@map("platform_owners")
}

model PlatformOwnerSession {
  id         String        @id @default(uuid(7)) @db.Uuid
  ownerId    String        @map("owner_id") @db.Uuid
  owner      PlatformOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the session token. The token itself is only ever in the
  /// owner's cookie.
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime      @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@index([expiresAt])
  @@map("platform_owner_sessions")
}
