// Tenant database: one tenant's application data.
//
// Every tenant has its own PostgreSQL database with this schema, so no table
// here carries a tenant id. The same migrations (prisma/tenant/migrations) are
// applied to each tenant database independently.
//
// The connection is configured in prisma/tenant.config.ts, not in this file.
//
// The release tables hold ownership and identity only. Review workflow,
// metadata and delivery columns are added once those requirements are agreed.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma/tenant"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// A category only. It grants no privileges; roles and permissions do.
enum CustomerType {
  artist
  label
  white_label

  @@map("customer_type")
}

enum CustomerStatus {
  active
  disabled

  @@map("customer_status")
}

/// Custom roles can be disabled; the master roles are always active (CHECK).
/// (.vibe/memory/role-privilege-management.md)
enum RoleStatus {
  active
  disabled

  @@map("role_status")
}

/// The two authorization domains of a tenant database: the tenant's staff
/// (Tenant and Sub-Tenants) and its customers (Customer and Sub-Customers).
enum AuthzDomain {
  tenant
  customer

  @@map("authz_domain")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Lower-case (checked in the database, see the init migration).
  email        String     @unique @db.VarChar(320)
  /// Login name, in the same format as platform owner user names (checked in
  /// the database). The tenant admin has one; customer users may not.
  username     String?    @unique @db.VarChar(64)
  /// Argon2id hash in PHC format. Never the password itself. Empty for users
  /// who cannot sign in with a password.
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(200)
  status       UserStatus @default(active)
  /// Set for a customer's users; empty for the tenant's own staff.
  customerId   String?    @map("customer_id") @db.Uuid
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// The tenant administrator written by provisioning, or the user of an
  /// approved main customer: always holds its master role (one primary staff
  /// user; one primary user per customer: partial unique indexes).
  isPrimary    Boolean    @default(false) @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Exactly one role per user (user_id is the key of user_roles).
  roleAssignment UserRole?
  createdRoles   Role[]                @relation("RoleCreatedBy")
  sessions       UserSession[]
  appearance     UserAppearance?
  /// The approved sign-up request this customer user was created from.
  registration   CustomerRegistration?

  @@index([customerId])
  @@map("users")
}

/// A tenant or customer role. A master role is recognised by `systemKey`
/// only and grants every privilege of its domain; a custom role grants its
/// stored privileges. Domain, system key and owner never change (trigger).
model Role {
  id              String      @id @default(uuid(7)) @db.Uuid
  /// "owner" (Master Tenant), "master_customer", or generated for custom roles.
  key             String      @unique @default(dbgenerated("('custom_'::text || replace((gen_random_uuid())::text, '-'::text, ''::text))")) @db.VarChar(100)
  /// Unique per scope (domain + owning main customer), case-insensitively.
  name            String      @db.VarChar(200)
  description     String?     @db.VarChar(500)
  /// Predefined by the platform; tenants cannot edit or delete it. Always
  /// equal to "has a system key" (CHECK).
  isSystem        Boolean     @default(false) @map("is_system")
  domain          AuthzDomain
  /// 'master_tenant' / 'master_customer' for the master roles (CHECK).
  systemKey       String?     @unique @map("system_key") @db.VarChar(50)
  status          RoleStatus  @default(active)
  /// The main customer that owns a custom customer role (required for those, empty otherwise).
  ownerCustomerId String?     @map("owner_customer_id") @db.Uuid
  ownerCustomer   Customer?   @relation("CustomerRoles", fields: [ownerCustomerId], references: [id], onDelete: Restrict)
  createdById     String?     @map("created_by_id") @db.Uuid
  createdBy       User?       @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@index([ownerCustomerId])
  @@map("roles")
}

/// Mirror of the tenant and customer domains of src/lib/authz/catalog.ts,
/// written by migrations only.
model Permission {
  id          String      @id @default(uuid(7)) @db.Uuid
  /// Stable identifier checked by the authorization service, e.g. "tenant.roles.view".
  key         String      @unique @db.VarChar(100)
  domain      AuthzDomain
  moduleKey   String      @map("module_key") @db.VarChar(100)
  action      String      @db.VarChar(50)
  /// Display text only.
  label       String      @db.VarChar(200)
  description String?     @db.VarChar(500)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([domain, moduleKey])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A user's single role. user_id is the key, so an assignment is an upsert
/// on user_id and two roles can never coexist. A trigger checks the domain
/// (staff ↔ tenant role, customer user ↔ customer role) and the customer scope.
model UserRole {
  userId    String   @id @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A role in use cannot be deleted (RESTRICT).
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([roleId])
  @@map("user_roles")
}

model Customer {
  id        String         @id @default(uuid(7)) @db.Uuid
  type      CustomerType
  name      String         @db.VarChar(200)
  status    CustomerStatus @default(active)
  /// Set for a sub-customer. A customer cannot be its own parent, and the
  /// hierarchy is one level deep (both checked in the database).
  parentId  String?        @map("parent_id") @db.Uuid
  parent    Customer?      @relation("CustomerHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Customer[]     @relation("CustomerHierarchy")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users         User[]
  /// Custom customer roles owned by this (main) customer.
  roles         Role[]         @relation("CustomerRoles")
  artists       Artist[]
  labels        Label[]
  audioReleases AudioRelease[]
  videoReleases VideoRelease[]

  @@index([parentId])
  @@map("customers")
}

model Artist {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name       String   @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  audioReleases AudioRelease[]
  videoReleases VideoRelease[]

  @@index([customerId])
  @@map("artists")
}

model Label {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name       String   @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  audioReleases AudioRelease[]
  videoReleases VideoRelease[]

  @@index([customerId])
  @@map("labels")
}

model AudioRelease {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  artistId   String?  @map("artist_id") @db.Uuid
  artist     Artist?  @relation(fields: [artistId], references: [id], onDelete: Restrict)
  labelId    String?  @map("label_id") @db.Uuid
  label      Label?   @relation(fields: [labelId], references: [id], onDelete: Restrict)
  title      String   @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assets ReleaseAsset[]

  @@index([customerId])
  @@index([artistId])
  @@index([labelId])
  @@map("audio_releases")
}

model VideoRelease {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  artistId   String?  @map("artist_id") @db.Uuid
  artist     Artist?  @relation(fields: [artistId], references: [id], onDelete: Restrict)
  labelId    String?  @map("label_id") @db.Uuid
  label      Label?   @relation(fields: [labelId], references: [id], onDelete: Restrict)
  title      String   @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assets ReleaseAsset[]

  @@index([customerId])
  @@index([artistId])
  @@index([labelId])
  @@map("video_releases")
}

/// Metadata for a stored file. Belongs to exactly one audio or one video
/// release (checked in the database).
model ReleaseAsset {
  id               String        @id @default(uuid(7)) @db.Uuid
  audioReleaseId   String?       @map("audio_release_id") @db.Uuid
  audioRelease     AudioRelease? @relation(fields: [audioReleaseId], references: [id], onDelete: Restrict)
  videoReleaseId   String?       @map("video_release_id") @db.Uuid
  videoRelease     VideoRelease? @relation(fields: [videoReleaseId], references: [id], onDelete: Restrict)
  /// Generated by the server. Never built from a client-supplied path.
  storageKey       String        @unique @map("storage_key") @db.VarChar(1024)
  originalFilename String        @map("original_filename") @db.VarChar(255)
  contentType      String        @map("content_type") @db.VarChar(255)
  sizeBytes        BigInt        @map("size_bytes")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([audioReleaseId])
  @@index([videoReleaseId])
  @@map("release_assets")
}

// ---------------------------------------------------------------------------
// Tenant portal: customer sign-up, sessions and appearance
// (.vibe/memory/customer-registration.md, workspace-auth.md, workspace-appearance.md)

/// Where a customer sign-up request stands. Pending and rejected applicants
/// have NO `users` row, so they can never hold a dashboard session.
enum RegistrationStatus {
  pending
  approved
  rejected

  @@map("registration_status")
}

/// Who reviewed a registration: a Platform Owner (id in the control plane)
/// or one of the tenant's own staff users (id in this database).
enum ReviewerType {
  platform_owner
  tenant_user

  @@map("reviewer_type")
}

/// The signed-in area a session belongs to. A session of one area is never
/// accepted by the other (also bound into the token hash).
enum SessionArea {
  tenant
  customer

  @@map("session_area")
}

/// Themes of the tenant portal (workspace appearance).
enum AppearanceTheme {
  light
  dark
  system

  @@map("appearance_theme")
}

/// Accent colours of the tenant portal; `neutral` is the application default.
enum AppearanceAccent {
  neutral
  emerald
  indigo
  violet
  blue
  rose
  amber

  @@map("appearance_accent")
}

/// Content width presets of the tenant portal.
enum AppearanceWidth {
  default
  full
  focused

  @@map("appearance_width")
}

/// A public customer sign-up request, waiting for (or after) approval.
model CustomerRegistration {
  id                   String             @id @default(uuid(7)) @db.Uuid
  fullName             String             @map("full_name") @db.VarChar(200)
  /// Lower-case (checked in the database).
  email                String             @db.VarChar(320)
  /// Same format as users.username (checked in the database).
  username             String             @db.VarChar(64)
  /// Argon2id hash in PHC format; copied to the user on approval. Never the password.
  passwordHash         String             @map("password_hash") @db.VarChar(255)
  accountType          CustomerType       @map("account_type")
  status               RegistrationStatus @default(pending)
  /// Required once rejected (checked in the database). Shown to the applicant.
  rejectionReason      String?            @map("rejection_reason") @db.VarChar(500)
  /// The applicant's optional message when asking for a new review.
  reviewRequestMessage String?            @map("review_request_message") @db.VarChar(1000)
  reviewRequestedAt    DateTime?          @map("review_requested_at") @db.Timestamptz(3)
  reviewedAt           DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewedByType       ReviewerType?      @map("reviewed_by_type")
  /// Not a foreign key: a Platform Owner's id lives in the control plane.
  reviewedById         String?            @map("reviewed_by_id") @db.Uuid
  /// The customer user created on approval (required once approved, checked in the database).
  userId               String?            @unique @map("user_id") @db.Uuid
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions RegistrationSession[]

  // One open (pending or rejected) request per email and per username:
  // partial unique indexes in the tenant_portal migration.
  @@index([status, createdAt])
  @@map("customer_registrations")
}

/// A signed-in session of a tenant staff user or a customer user. Only the
/// SHA-256 of `<tenantId>:<area>:<token>` is stored; the token is in the cookie.
model UserSession {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       SessionArea
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime    @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// A limited session of a rejected applicant: it opens only the registration
/// status page (reason and review request), never a dashboard.
model RegistrationSession {
  id             String               @id @default(uuid(7)) @db.Uuid
  registrationId String               @map("registration_id") @db.Uuid
  registration   CustomerRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash      String               @unique @map("token_hash") @db.Char(64)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)

  @@index([registrationId])
  @@index([expiresAt])
  @@map("registration_sessions")
}

/// The workspace default appearance, set by the tenant administrator. Exactly
/// one row (CHECK on id). Applies to public pages and users without an override.
model WorkspaceAppearance {
  id        String           @id @default("workspace") @db.VarChar(32)
  theme     AppearanceTheme
  accent    AppearanceAccent
  width     AppearanceWidth  @default(default)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("workspace_appearance")
}

/// One personal appearance override per user of this tenant.
model UserAppearance {
  userId    String           @id @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     AppearanceTheme
  accent    AppearanceAccent
  width     AppearanceWidth  @default(default)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_appearances")
}
