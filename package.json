{
  "name": "music-distribution",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --config prisma/control.config.ts && prisma generate --config prisma/tenant.config.ts",
    "db:deploy": "npm run db:control:deploy && npm run db:tenants:deploy",
    "db:control:deploy": "prisma migrate deploy --config prisma/control.config.ts",
    "db:control:migrate": "prisma migrate dev --config prisma/control.config.ts",
    "db:control:status": "prisma migrate status --config prisma/control.config.ts",
    "db:tenants:deploy": "tsx prisma/migrate-tenants.ts",
    "db:tenant:migrate": "prisma migrate dev --config prisma/tenant.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:rotate-password": "tsx prisma/seed.ts --rotate-password"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
